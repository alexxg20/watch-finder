# ==============================================================================
# Watch Hunter Configuration Template (.env.example)
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Notification Target
# ------------------------------------------------------------------------------
NOTIFICATION_EMAIL=2alex.garcia2@gmail.com

# ------------------------------------------------------------------------------
# Watch Search Criteria (Defaults)
# ------------------------------------------------------------------------------
# Comma-separated or JSON list of target watch references
TARGET_REFERENCES=["231.10.39.21.02.002", "231.10.39.21.02.001"]
MIN_PRICE_EUR=2500.0
MAX_PRICE_EUR=3500.0
MIN_CONDITION=good
ALLOW_UNKNOWN_CONDITION=true

# ------------------------------------------------------------------------------
# eBay API Credentials (Official eBay Browse API)
# Register at https://developer.ebay.com/ to create an Application Key (Client ID & Client Secret)
# ------------------------------------------------------------------------------
EBAY_CLIENT_ID=your_ebay_app_client_id_here
EBAY_CLIENT_SECRET=your_ebay_cert_client_secret_here
EBAY_MARKETPLACE_ID=EBAY_DE

# ------------------------------------------------------------------------------
# Reddit API Credentials (Official Reddit Developer App)
# Create a 'script' app at https://www.reddit.com/prefs/apps
# ------------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=python:watch_hunter:v0.1.0 (by /u/your_reddit_username)

# ------------------------------------------------------------------------------
# Email Service: Resend (Recommended)
# Sign up at https://resend.com/ and create an API key
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Watch Hunter <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# Email Service: SMTP (Alternative to Resend)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=Watch Hunter <your_email@gmail.com>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# ------------------------------------------------------------------------------
# Persistent State & Runtime Flags
# ------------------------------------------------------------------------------
STATE_FILE_PATH=data/seen_listings.json
DRY_RUN=false
LOG_LEVEL=INFO
